{
  "schemaVersion": 1,
  "id": "stockpouches",
  "version": "${version}",
  "name": "Stock Pouches",
  "description": "Specialized pouches for keeping massive stocks of mundane resources.",
  "icon": "assets/stockpouches/icon.png",
  "authors": ["Paramada"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.paramada.stockpouches.client.StockpouchesDataGenerator"
    ],
    "client": [
      "net.paramada.stockpouches.client.StockpouchesClient"
    ],
    "main": [
      "net.paramada.stockpouches.Stockpouches"
    ]
  },
  "mixins": [
    "stockpouches.mixins.json",
    {
      "config": "stockpouches.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
